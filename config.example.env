# 设置保存在 ~/.n8n-job-hunter/config.local.env（权限 600，不进 git）。
# 推荐用命令逐项设置：  scripts/jobhunt config set 名字 [值]   （不写值时是隐藏输入，适合密钥和密码）
# 这个文件只是清单和默认值说明。

# ---- AI（任意 OpenAI 兼容接口，例如 DeepSeek）-------------------------------------------
AI_BASE_URL='https://api.deepseek.com'
AI_API_KEY=''
AI_MODEL='deepseek-chat'
AI_JSON_MODE='on'          # off = 接口不支持 response_format=json_object 时关掉（程序仍会从回答里截取 JSON）
AI_DELAY_MS='400'          # 两次 AI 调用之间停多少毫秒（接口限速时调大）

# ---- 找什么 ---------------------------------------------------------------------------
# 搜索关键词，逗号分隔（Jooble 每个关键词搜一次；Remotive 不按关键词过滤，一次请求）
JOB_KEYWORDS=''
# 目标地区：hk 香港（默认）/ cn 中国大陆 / tw 台湾 / sg 新加坡 / jp 日本 / us 美国 / uk 英国 / ca 加拿大 / au 澳大利亚 / global 不限地区（只看可远程）
JOB_REGION='hk'
JOB_LOCATION=''            # 更具体的地点（如 Kowloon），填了就用它搜索，留空用上面的地区
# 职位来源：至少配一个
JOOBLE_API_KEY=''          # jooble.org 免费申请的 API key
JOB_RSS_URLS=''            # 任意 RSS（例如 rss.app 把 LinkedIn 搜索页转成的地址），空格分隔
REMOTIVE='off'             # on = 用 Remotive（免费，只有远程岗位）
JOB_MAX_AGE_DAYS='30'      # 忽略发布超过这么多天的岗位

# ---- 怎么判断和投递 ---------------------------------------------------------------------
MIN_SCORE='7'                    # AI 评分（0-10）达到这个分才会投
MAX_JOBS_PER_RUN='40'            # 每天最多处理多少个新岗位
MAX_APPLICATIONS_PER_DAY='10'    # 每天最多自动发多少封邮件；0 = 暂停自动发送（岗位只列出一次）
RECIPIENT_COOLDOWN_DAYS='30'     # 同一个邮箱多少天内不重复发（找邮箱和发送两处都遵守）
AUTO_SEND='on'                   # off = 只写信、只列清单，从不发邮件
MAIL_MAX_CHARS='900'             # 邮件正文长度：中文按字数，英文约为五分之一的单词数
PAGE_EMAILS='off'                # on = 岗位网页上找到的邮箱也拿来投递（默认只信岗位正文里写明的邮箱）

# ---- 发信邮箱（SMTP）和简历 -------------------------------------------------------------
# Gmail：host smtp.gmail.com，端口 465，密码要用"应用专用密码"（不是登录密码）
SMTP_HOST=''
SMTP_PORT='465'
SMTP_SECURE=''             # 留空 = 465 端口用 SSL、其它端口用 STARTTLS（非本机服务器必须加密）；on = SSL；off = STARTTLS
SMTP_USER=''
SMTP_PASS=''
SMTP_FROM=''               # 不填则用 SMTP_USER
MAIL_FROM_NAME=''          # 不填则取 profile.md 里的姓名
REPLY_TO=''                # 不填则取 profile.md 里的邮箱
# 简历 PDF 的绝对路径。必须放在 ~/Documents、~/Desktop、~/Downloads 之外（定时任务读不了那些目录），例如：
# ~/.n8n-job-hunter/profile/resume.pdf
RESUME_FILE=''

# ---- 测试模式：填了就把所有投递邮件改发到这个邮箱（真正的收件人收不到），要正式投递时清空 ----------
MAIL_REDIRECT_TO=''

# ---- 可选：没有邮箱的岗位去网上搜 HR 邮箱（默认关，风险更高；只对来源里给了公司名的岗位做，RSS 岗位不做）----
HR_EMAIL_SEARCH='off'      # 下面两个 key 都要填才会搜：搜到的邮箱必须经 MailboxLayer 确认存在才会采用
SERPER_API_KEY=''
MAILBOXLAYER_API_KEY=''      # 默认走 https；免费套餐不支持 https 时不会验证、也不会采用搜到的邮箱（日报里会提示）

# ---- 每日报告也发到 Discord（可选）；运行时间 -----------------------------------------------
DISCORD_WEBHOOK_URL=''
# 每天几点运行。它就是定时任务的时间：用 jobhunt config set HUNT_TIME 09:30 或控制台修改，会同时重装定时任务（之后 20/40/90 分钟补跑，跨午夜的不安排）
HUNT_TIME='08:00'
